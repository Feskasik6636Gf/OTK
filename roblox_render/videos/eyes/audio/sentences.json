  "end": 45.22,
  "startFrame": 1310,
  "endFrame": 1357,
  "words": [
   150,
   157
  ]
 },
 {
  "text": "And for a whole year, she never took it off.",
  "start": 45.4,
  "end": 47.48,
  "startFrame": 1362,
  "endFrame": 1424,
  "words": [
   158,
   167
  ]
 },
 {
  "text": "Best year ever.",
  "start": 47.82,
  "end": 48.66,
  "startFrame": 1435,
  "endFrame": 1460,
  "words": [
   168,
   170
  ]
 },
 {
  "text": "Cookies for breakfast.",
  "start": 49.08,
  "end": 49.84,
  "startFrame": 1472,
  "endFrame": 1495,
  "words": [
   171,
   173
  ]
 },
 {
  "text": "Video games at 3AM.",
  "start": 50.12,
  "end": 51.14,
  "startFrame": 1504,
  "endFrame": 1534,
  "words": [
   174,
   177
  ]
 },
 {
  "text": "Freedom!",
  "start": 51.59,
  "end": 51.79,
  "startFrame": 1548,
  "endFrame": 1554,
  "words": [
   178,
   178
  ]
 },
 {
  "text": "But then we went to the beach.",
  "start": 52.21,
  "end": 53.35,
  "startFrame": 1566,
  "endFrame": 1600,
  "words": [
   179,
   185
  ]
 },
