  "start": 92.81,
  "end": 92.93,
  "startFrame": 2784,
  "endFrame": 2788,
  "words": [
   311,
   311
  ]
 },
 {
  "text": "That night, I threw the beanie in the trash.",
  "start": 93.38,
  "end": 95.06,
  "startFrame": 2801,
  "endFrame": 2852,
  "words": [
   312,
   320
  ]
 },
 {
  "text": "\"Keep them open, Mom.",
  "start": 95.4,
  "end": 96.08,
  "startFrame": 2862,
  "endFrame": 2882,
  "words": [
   321,
   324
  ]
 },
 {
  "text": "Forever.\"",
  "start": 96.48,
  "end": 96.66,
  "startFrame": 2894,
  "endFrame": 2900,
  "words": [
   325,
   325
  ]
 },
 {
  "text": "All four of her eyes cried.",
  "start": 97.11,
  "end": 98.31,
  "startFrame": 2913,
  "endFrame": 2949,
  "words": [
   326,
   331
  ]
 },
