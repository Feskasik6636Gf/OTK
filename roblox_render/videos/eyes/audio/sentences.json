[
 {
  "text": "I spent a whole year trying to blind my mom.",
  "start": 0.0,
  "end": 2.32,
  "startFrame": 0,
  "endFrame": 70,
  "words": [
   0,
   9
  ]
 },
 {
  "text": "Then, her secret eyes saved my little sister's life.",
  "start": 2.72,
  "end": 5.34,
  "startFrame": 82,
  "endFrame": 160,
  "words": [
   10,
   18
  ]
 },
 {
  "text": "You see, in this world, every mom has a second pair of eyes on the back of her head.",
  "start": 5.78,
  "end": 9.38,
  "startFrame": 173,
  "endFrame": 281,
  "words": [
   19,
   37
  ]
 },
 {
  "text": "Real ones.",
  "start": 9.8,
  "end": 10.18,
  "startFrame": 294,
  "endFrame": 305,
  "words": [
   38,
   39
  ]
 },
 {
  "text": "They blink.",
  "start": 10.52,
  "end": 10.82,
  "startFrame": 316,
  "endFrame": 325,
  "words": [
   40,
   41
  ]
 },
 {
  "text": "They roll.",
  "start": 11.18,
  "end": 11.58,
  "startFrame": 335,
  "endFrame": 347,
  "words": [
   42,
   43
  ]
 },
 {
  "text": "They cry at movies.",
  "start": 11.86,
  "end": 12.62,
  "startFrame": 356,
  "endFrame": 379,
  "words": [
   44,
   47
  ]
 },
 {
  "text": "So moms see everything.",
  "start": 13.02,
  "end": 14.26,
  "startFrame": 391,
  "endFrame": 428,
  "words": [
   48,
   51
  ]
 },
 {
  "text": "Teachers face the board and still catch you passing notes.",
  "start": 14.66,
  "end": 16.9,
  "startFrame": 440,
  "endFrame": 507,
  "words": [
   52,
   61
  ]
 },
 {
  "text": "Moms drive forward and stare at the back seat at the same time.",
  "start": 17.35,
  "end": 20.01,
  "startFrame": 520,
  "endFrame": 600,
  "words": [
   62,
   74
  ]
 },
 {
  "text": "Barbers have to cut around them very, very carefully.",
  "start": 20.35,
  "end": 22.65,
  "startFrame": 610,
  "endFrame": 680,
  "words": [
   75,
   83
  ]
 },
 {
  "text": "And no kid in history has ever stolen a cookie.",
  "start": 22.99,
  "end": 25.29,
  "startFrame": 690,
  "endFrame": 759,
  "words": [
   84,
   93
  ]
 },
 {
  "text": "Ever.",
  "start": 25.67,
  "end": 25.85,
  "startFrame": 770,
  "endFrame": 776,
  "words": [
   94,
   94
  ]
 },
 {
  "text": "Except me.",
  "start": 26.21,
  "end": 26.69,
  "startFrame": 786,
  "endFrame": 801,
  "words": [
   95,
   96
  ]
 },
 {
  "text": "I tried every single day.",
  "start": 26.91,
  "end": 28.41,
  "startFrame": 807,
  "endFrame": 852,
  "words": [
   97,
   101
  ]
 },
 {
  "text": "I tiptoed.",
  "start": 28.69,
  "end": 29.33,
  "startFrame": 861,
  "endFrame": 880,
  "words": [
   102,
   103
  ]
 },
 {
  "text": "Blink.",
  "start": 29.44,
  "end": 29.71,
  "startFrame": 883,
  "endFrame": 891,
  "words": [
   104,
   104
  ]
 },
 {
  "text": "\"Put it back.\"",
  "start": 30.07,
  "end": 30.57,
  "startFrame": 902,
  "endFrame": 917,
  "words": [
   105,
   107
  ]
 },
 {
  "text": "I crawled.",
  "start": 30.91,
  "end": 31.35,
  "startFrame": 927,
  "endFrame": 940,
  "words": [
   108,
   109
  ]
 },
 {
  "text": "Blink.",
  "start": 31.8,
  "end": 31.86,
  "startFrame": 954,
  "endFrame": 956,
  "words": [
   110,
   110
  ]
 },
 {
  "text": "\"Put it back.\"",
  "start": 32.24,
  "end": 32.84,
  "startFrame": 967,
  "endFrame": 985,
  "words": [
   111,
   113
  ]
 },
 {
  "text": "I dressed up as the dog.",
  "start": 33.16,
  "end": 34.22,
  "startFrame": 995,
  "endFrame": 1027,
  "words": [
   114,
   119
  ]
 },
 {
  "text": "Blink.",
  "start": 34.58,
  "end": 34.72,
  "startFrame": 1037,
  "endFrame": 1042,
  "words": [
   120,
   120
  ]
 },
 {
  "text": "\"Put it back, Max.\"",
  "start": 35.08,
  "end": 35.76,
  "startFrame": 1052,
  "endFrame": 1073,
  "words": [
   121,
   124
  ]
 },
 {
  "text": "So on my birthday, I made my wish.",
  "start": 36.2,
  "end": 37.88,
  "startFrame": 1086,
  "endFrame": 1136,
  "words": [
   125,
   132
  ]
 },
 {
  "text": "\"Mom, I want privacy.",
  "start": 38.33,
  "end": 39.45,
  "startFrame": 1150,
  "endFrame": 1184,
  "words": [
   133,
   136
  ]
 },
 {
  "text": "Please cover your back eyes.",
  "start": 39.9,
  "end": 40.92,
  "startFrame": 1197,
  "endFrame": 1228,
  "words": [
   137,
   141
  ]
 },
 {
  "text": "Forever.\"",
  "start": 41.32,
  "end": 41.56,
  "startFrame": 1240,
  "endFrame": 1247,
  "words": [
   142,
   142
  ]
 },
 {
  "text": "She looked sad with all four eyes.",
  "start": 41.94,
  "end": 43.4,
  "startFrame": 1258,
  "endFrame": 1302,
  "words": [
   143,
   149
  ]
 },
 {
