  "end": 79.04,
  "startFrame": 2365,
  "endFrame": 2371,
  "words": [
   266,
   266
  ]
 },
 {
  "text": "Looked left.",
  "start": 79.31,
  "end": 79.66,
  "startFrame": 2379,
  "endFrame": 2390,
  "words": [
   267,
   268
  ]
 },
