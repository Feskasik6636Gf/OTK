  "start": 67.14,
  "end": 68.04,
  "startFrame": 2014,
  "endFrame": 2041,
  "words": [
   226,
   229
  ]
 },
 {
  "text": "Then I noticed something.",
  "start": 68.3,
  "end": 69.38,
  "startFrame": 2049,
  "endFrame": 2081,
  "words": [
   230,
   233
  ]
 },
 {
