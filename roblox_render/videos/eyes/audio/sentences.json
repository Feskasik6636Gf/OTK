  "start": 54.92,
  "end": 56.6,
  "startFrame": 1648,
  "endFrame": 1698,
  "words": [
   189,
   196
  ]
 },
 {
  "text": "And my little sister floated away on her inflatable duck.",
  "start": 56.6,
  "end": 59.3,
  "startFrame": 1698,
  "endFrame": 1779,
  "words": [
   197,
   206
  ]
 },
 {
