  "end": 100.09,
  "startFrame": 2959,
  "endFrame": 3003,
  "words": [
   332,
   339
  ]
 },
 {
  "text": "Blink.",
  "start": 100.51,
  "end": 100.55,
  "startFrame": 3015,
  "endFrame": 3016,
  "words": [
   340,
   340
  ]
 },
 {
  "text": "\"Put it back.\"",
  "start": 100.93,
  "end": 101.39,
  "startFrame": 3028,
  "endFrame": 3042,
  "words": [
   341,
   343
  ]
 },
