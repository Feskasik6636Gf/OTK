  "end": 43.89,
  "startFrame": 1294,
  "endFrame": 1317,
  "words": [
   140,
   142
  ]
 },
 {
  "text": "He was coming.",
  "start": 44.23,
  "end": 44.87,
  "startFrame": 1327,
  "endFrame": 1346,
  "words": [
   143,
   145
  ]
 },
 {
  "text": "Then I noticed something.",
  "start": 45.25,
  "end": 46.39,
  "startFrame": 1358,
  "endFrame": 1392,
  "words": [
   146,
   149
  ]
 },
 {
