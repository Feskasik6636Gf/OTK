  "end": 30.67,
  "startFrame": 890,
  "endFrame": 920,
  "words": [
   92,
   96
  ]
 },
 {
  "text": "The mayor was ready to ring the dinner bell.",
  "start": 31.01,
  "end": 32.73,
  "startFrame": 930,
  "endFrame": 982,
  "words": [
   97,
   105
  ]
 },
 {
  "text": "But under the square lived the Table Eater, a giant monster with a napkin around his neck.",
  "start": 33.01,
  "end": 37.19,
  "startFrame": 990,
  "endFrame": 1116,
  "words": [
   106,
   122
  ]
 },
 {
