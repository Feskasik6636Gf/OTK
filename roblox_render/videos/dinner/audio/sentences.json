[
 {
  "text": "I asked, \"What's for dinner?\"",
  "start": 0.0,
  "end": 1.18,
  "startFrame": 0,
  "endFrame": 35,
  "words": [
   0,
   4
  ]
 },
 {
  "text": "so many times that my family hasn't eaten since Tuesday.",
  "start": 1.18,
  "end": 4.0,
  "startFrame": 35,
  "endFrame": 120,
  "words": [
   5,
   14
  ]
 },
 {
  "text": "And it saved the whole town.",
  "start": 4.42,
  "end": 5.98,
  "startFrame": 133,
  "endFrame": 179,
  "words": [
   15,
   20
  ]
 },
 {
  "text": "You see, in this world, every time someone asks, \"What's for dinner?\", dinner gets pushed back one hour.",
  "start": 6.26,
  "end": 10.98,
  "startFrame": 188,
  "endFrame": 329,
  "words": [
   21,
   38
  ]
 },
 {
  "text": "Ding!",
  "start": 11.15,
  "end": 11.86,
  "startFrame": 334,
  "endFrame": 356,
  "words": [
   39,
   39
  ]
 },
 {
  "text": "So everyone is careful.",
  "start": 11.86,
  "end": 13.02,
  "startFrame": 356,
  "endFrame": 391,
  "words": [
   40,
   43
  ]
 },
 {
  "text": "Moms say, \"Surprise!\"",
  "start": 13.38,
  "end": 14.32,
  "startFrame": 401,
  "endFrame": 430,
  "words": [
   44,
   46
  ]
 },
 {
  "text": "Dads say, \"Food.\"",
  "start": 14.77,
  "end": 15.61,
  "startFrame": 443,
  "endFrame": 468,
  "words": [
   47,
   49
  ]
 },
 {
  "text": "Grandmas just hand you a pickle and walk away.",
  "start": 16.06,
  "end": 17.82,
  "startFrame": 482,
  "endFrame": 535,
  "words": [
   50,
   58
  ]
 },
 {
  "text": "But I always ask, \"What's for dinner?\"",
  "start": 18.1,
  "end": 20.0,
  "startFrame": 543,
  "endFrame": 600,
  "words": [
   59,
   65
  ]
 },
 {
  "text": "\"What's for dinner?\"",
  "start": 20.45,
  "end": 20.87,
  "startFrame": 614,
  "endFrame": 626,
  "words": [
   66,
   68
  ]
 },
 {
  "text": "Ding!",
  "start": 21.19,
  "end": 21.41,
  "startFrame": 636,
  "endFrame": 642,
  "words": [
   69,
   69
  ]
 },
 {
  "text": "My brother chewed the remote.",
  "start": 21.83,
  "end": 23.01,
  "startFrame": 655,
  "endFrame": 690,
  "words": [
   70,
   74
  ]
 },
 {
