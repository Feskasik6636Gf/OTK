[
 {
  "text": "In this city, everyone has a number floating above their head, and it drops by one every midnight.",
  "start": 0.0,
  "end": 4.74,
  "startFrame": 0,
  "endFrame": 142,
  "words": [
   0,
   17
  ]
 },
 {
  "text": "Nobody can see their own.",
  "start": 5.18,
  "end": 6.2,
  "startFrame": 155,
  "endFrame": 186,
  "words": [
   18,
   22
  ]
 },
 {
  "text": "At zero, you vanish, and nobody ever says your name again.",
  "start": 6.52,
  "end": 9.74,
  "startFrame": 196,
  "endFrame": 292,
  "words": [
   23,
   33
  ]
 },
 {
  "text": "Tarasik has 9,412 and brags about it.",
  "start": 10.08,
  "end": 13.32,
  "startFrame": 302,
  "endFrame": 400,
  "words": [
   34,
   40
  ]
 },
 {
  "text": "My mom's number is 11.",
  "start": 13.52,
  "end": 14.66,
  "startFrame": 406,
  "endFrame": 440,
  "words": [
   41,
   45
  ]
 },
 {
  "text": "\"It's a mistake,\" she says.",
  "start": 14.98,
  "end": 16.26,
  "startFrame": 449,
  "endFrame": 488,
  "words": [
   46,
   50
  ]
 },
 {
  "text": "Every morning, I watch it fall.",
  "start": 16.62,
  "end": 18.06,
  "startFrame": 499,
  "endFrame": 542,
  "words": [
   51,
   56
  ]
 },
 {
  "text": "10, 9, 8.",
  "start": 18.46,
  "end": 19.66,
  "startFrame": 554,
  "endFrame": 590,
  "words": [
   57,
   59
  ]
 },
 {
  "text": "In the library, I found a torn page.",
  "start": 20.02,
  "end": 21.92,
  "startFrame": 601,
  "endFrame": 658,
  "words": [
   60,
   67
  ]
 },
 {
  "text": "\"A number can be given.",
  "start": 22.18,
  "end": 23.22,
  "startFrame": 665,
  "endFrame": 697,
  "words": [
   68,
   72
  ]
 },
 {
  "text": "Press your forehead to theirs and say, take mine.\"",
  "start": 23.56,
  "end": 25.68,
  "startFrame": 707,
  "endFrame": 770,
  "words": [
   73,
   81
  ]
 },
 {
  "text": "That night, mom had two days left.",
  "start": 25.9,
  "end": 27.84,
  "startFrame": 777,
  "endFrame": 835,
  "words": [
   82,
   88
  ]
 },
 {
  "text": "I pressed my forehead to hers and whispered the words.",
  "start": 27.84,
  "end": 30.42,
  "startFrame": 835,
  "endFrame": 913,
  "words": [
   89,
   98
  ]
 },
 {
  "text": "In the morning, above her head floated 400.",
  "start": 30.76,
  "end": 32.9,
  "startFrame": 923,
  "endFrame": 987,
  "words": [
   99,
   106
  ]
 },
 {
  "text": "Mom woke up and screamed.",
  "start": 33.52,
  "end": 34.94,
  "startFrame": 1006,
  "endFrame": 1048,
  "words": [
   107,
   111
  ]
 },
 {
  "text": "\"What did you do?\"",
  "start": 35.32,
  "end": 36.18,
  "startFrame": 1060,
  "endFrame": 1085,
  "words": [
   112,
   115
  ]
 },
 {
  "text": "Tarasik stared at me and went pale.",
  "start": 36.56,
  "end": 38.2,
  "startFrame": 1097,
  "endFrame": 1146,
  "words": [
   116,
   122
  ]
 },
 {
  "text": "\"Your number is one.\"",
  "start": 38.46,
  "end": 39.36,
  "startFrame": 1154,
  "endFrame": 1181,
  "words": [
   123,
   126
  ]
 },
 {
  "text": "Mom grabbed my face.",
  "start": 39.76,
  "end": 40.8,
  "startFrame": 1193,
  "endFrame": 1224,
  "words": [
   127,
   130
  ]
 },
 {
  "text": "\"Take it back, right now!\"",
  "start": 41.14,
  "end": 42.42,
  "startFrame": 1234,
  "endFrame": 1273,
  "words": [
   131,
   135
  ]
 },
 {
  "text": "\"I can't,\" I said.",
  "start": 42.72,
  "end": 43.72,
  "startFrame": 1282,
  "endFrame": 1312,
  "words": [
   136,
   139
  ]
 },
 {
  "text": "\"A gift can't be returned.\"",
  "start": 43.98,
  "end": 45.26,
  "startFrame": 1319,
  "endFrame": 1358,
  "words": [
   140,
   144
  ]
 },
 {
  "text": "Then she stopped.",
  "start": 45.52,
  "end": 46.16,
  "startFrame": 1366,
  "endFrame": 1385,
  "words": [
   145,
   147
  ]
 },
 {
  "text": "\"Do you know why mine was 11?\"",
  "start": 46.44,
  "end": 47.7,
  "startFrame": 1393,
  "endFrame": 1431,
  "words": [
   148,
   154
  ]
 },
 {
  "text": "she asked.",
  "start": 47.94,
  "end": 48.48,
  "startFrame": 1438,
  "endFrame": 1454,
  "words": [
   155,
   156
  ]
 },
 {
  "text": "I shook my head.",
  "start": 48.74,
  "end": 49.4,
  "startFrame": 1462,
  "endFrame": 1482,
  "words": [
   157,
   160
  ]
 },
 {
  "text": "\"You were born sick.",
  "start": 49.66,
  "end": 50.54,
  "startFrame": 1490,
  "endFrame": 1516,
  "words": [
   161,
   164
  ]
 },
 {
  "text": "The doctors gave you three days.",
  "start": 50.82,
  "end": 52.44,
  "startFrame": 1525,
  "endFrame": 1573,
  "words": [
   165,
   170
  ]
 },
 {
  "text": "So every night since, I whispered those words to you.",
  "start": 52.76,
  "end": 55.32,
  "startFrame": 1583,
  "endFrame": 1660,
  "words": [
   171,
   180
  ]
 },
 {
  "text": "Your number was never yours.\"",
  "start": 55.5,
  "end": 56.94,
  "startFrame": 1665,
  "endFrame": 1708,
  "words": [
   181,
   185
  ]
 },
 {
  "text": "Midnight was an hour away.",
  "start": 57.16,
  "end": 58.58,
  "startFrame": 1715,
  "endFrame": 1757,
  "words": [
   186,
   190
  ]
 },
 {
  "text": "Mom pressed her forehead to mine one last time.",
  "start": 58.94,
  "end": 61.12,
  "startFrame": 1768,
  "endFrame": 1834,
  "words": [
   191,
   199
  ]
 },
 {
  "text": "\"Take mine,\" she said.",
  "start": 61.32,
  "end": 62.54,
  "startFrame": 1840,
  "endFrame": 1876,
  "words": [
   200,
   203
  ]
 },
 {
  "text": "Tarasik gasped.",
  "start": 62.86,
  "end": 63.74,
  "startFrame": 1886,
  "endFrame": 1912,
  "words": [
   204,
   205
  ]
 },
 {
  "text": "Above my head, the number exploded into thousands.",
  "start": 64.16,
  "end": 66.64,
  "startFrame": 1925,
  "endFrame": 1999,
  "words": [
   206,
   213
  ]
 },
 {
  "text": "Above hers was zero.",
  "start": 67.06,
  "end": 68.32,
  "startFrame": 2012,
  "endFrame": 2050,
  "words": [
   214,
   217
  ]
 },
 {
  "text": "She smiled and kissed my hair.",
  "start": 68.7,
  "end": 70.2,
  "startFrame": 2061,
  "endFrame": 2106,
  "words": [
   218,
   223
  ]
 },
 {
  "text": "Then the clock struck 12 and the kitchen was empty.",
  "start": 70.52,
  "end": 72.78,
  "startFrame": 2116,
  "endFrame": 2183,
  "words": [
   224,
   233
  ]
 },
 {
  "text": "Everyone says I must forget her name.",
  "start": 73.14,
  "end": 74.78,
  "startFrame": 2194,
  "endFrame": 2243,
  "words": [
   234,
   240
  ]
 },
 {
  "text": "So every midnight, I whisper it anyway.",
  "start": 75.06,
  "end": 77.02,
  "startFrame": 2252,
  "endFrame": 2311,
  "words": [
   241,
   247
  ]
 },
 {
  "text": "\"Marina.\"",
  "start": 77.34,
  "end": 77.64,
  "startFrame": 2320,
  "endFrame": 2329,
  "words": [
   248,
   248
  ]
 },
 {
  "text": "And the number above my head has never dropped since.",
  "start": 78.06,
  "end": 80.5,
  "startFrame": 2342,
  "endFrame": 2415,
  "words": [
   249,
   258
  ]
 }
]