[
 {
  "text": "In this city, hundreds of doors appear every night, and every single one leads somewhere.",
  "start": 0.0,
  "end": 4.8,
  "startFrame": 0,
  "endFrame": 144,
  "words": [
   0,
   14
  ]
 },
 {
  "text": "By sunrise, they vanish.",
  "start": 5.12,
  "end": 6.4,
  "startFrame": 154,
  "endFrame": 192,
  "words": [
   15,
   18
  ]
 },
 {
  "text": "My friend Tarasic opened a purple door and found a beach with square waves.",
  "start": 6.82,
  "end": 10.36,
  "startFrame": 205,
  "endFrame": 311,
  "words": [
   19,
   32
  ]
 },
 {
  "text": "There was only one rule.",
  "start": 10.7,
  "end": 11.84,
  "startFrame": 321,
  "endFrame": 355,
  "words": [
   33,
   37
  ]
 },
 {
  "text": "Be back before sunrise.",
  "start": 12.1,
  "end": 13.36,
  "startFrame": 363,
  "endFrame": 401,
  "words": [
   38,
   41
  ]
 },
 {
  "text": "Otherwise, the door vanishes with you inside.",
  "start": 13.74,
  "end": 16.0,
  "startFrame": 412,
  "endFrame": 480,
  "words": [
   42,
   48
  ]
 },
 {
  "text": "My dad calls the doors a trap.",
  "start": 16.34,
  "end": 17.88,
  "startFrame": 490,
  "endFrame": 536,
  "words": [
   49,
   55
  ]
 },
 {
  "text": "Mom didn't listen.",
  "start": 18.28,
  "end": 19.0,
  "startFrame": 548,
  "endFrame": 570,
  "words": [
   56,
   58
  ]
 },
 {
  "text": "A year ago, she walked into a green one and said, \"Just a quick look.\"",
  "start": 19.3,
  "end": 22.36,
  "startFrame": 579,
  "endFrame": 671,
  "words": [
   59,
   73
  ]
 },
 {
  "text": "She came back at dawn, smiling, but something was off.",
  "start": 22.58,
  "end": 25.46,
  "startFrame": 677,
  "endFrame": 764,
  "words": [
   74,
   83
  ]
 },
 {
  "text": "She hummed songs I had never heard.",
  "start": 25.72,
  "end": 27.4,
  "startFrame": 772,
  "endFrame": 822,
  "words": [
   84,
   90
  ]
 },
 {
  "text": "She forgot I hate mushrooms.",
  "start": 27.68,
  "end": 29.24,
  "startFrame": 830,
  "endFrame": 877,
  "words": [
   91,
   95
  ]
 },
 {
  "text": "Dad watched her all through dinner.",
  "start": 29.43,
  "end": 31.0,
  "startFrame": 883,
  "endFrame": 930,
  "words": [
   96,
   101
  ]
 },
 {
  "text": "Then he whispered, \"Rock and roll, lose control.\"",
  "start": 31.28,
  "end": 33.3,
  "startFrame": 938,
  "endFrame": 999,
  "words": [
   102,
   109
  ]
 },
 {
  "text": "Our secret code for run.",
  "start": 33.62,
  "end": 34.98,
  "startFrame": 1009,
  "endFrame": 1049,
  "words": [
   110,
   114
  ]
 },
 {
  "text": "Last week, I finally searched for the green door.",
  "start": 35.38,
  "end": 37.62,
  "startFrame": 1061,
  "endFrame": 1129,
  "words": [
   115,
   123
  ]
 },
 {
  "text": "It appeared behind the school, glowing like a candy wrapper.",
  "start": 37.94,
  "end": 40.34,
  "startFrame": 1138,
  "endFrame": 1210,
  "words": [
   124,
   133
  ]
 },
 {
  "text": "\"If you don't come back, I'll tell everyone you were brave.\"",
  "start": 40.68,
  "end": 43.08,
  "startFrame": 1220,
  "endFrame": 1292,
  "words": [
   134,
   144
  ]
 },
 {
  "text": "I stepped inside.",
  "start": 43.42,
  "end": 44.16,
  "startFrame": 1303,
  "endFrame": 1325,
  "words": [
   145,
   147
  ]
 },
 {
  "text": "Darkness, then a kitchen.",
  "start": 44.56,
  "end": 45.86,
  "startFrame": 1337,
  "endFrame": 1376,
  "words": [
   148,
   151
  ]
 },
 {
  "text": "My kitchen.",
  "start": 46.18,
  "end": 46.7,
  "startFrame": 1385,
  "endFrame": 1401,
  "words": [
   152,
   153
  ]
 },
 {
  "text": "At the table sat my real mom, tied to a chair.",
  "start": 46.96,
  "end": 49.52,
  "startFrame": 1409,
  "endFrame": 1486,
  "words": [
   154,
   164
  ]
 },
 {
  "text": "\"Run,\" she mouthed.",
  "start": 49.9,
  "end": 50.98,
  "startFrame": 1497,
  "endFrame": 1529,
  "words": [
   165,
   167
  ]
 },
 {
  "text": "Behind me, the door slammed shut.",
  "start": 51.2,
  "end": 52.7,
  "startFrame": 1536,
  "endFrame": 1581,
  "words": [
   168,
   173
  ]
 },
 {
  "text": "Mom laughed, but it came from the ceiling.",
  "start": 53.02,
  "end": 54.84,
  "startFrame": 1591,
  "endFrame": 1645,
  "words": [
   174,
   181
  ]
 },
 {
  "text": "Dozens of faces were pressed into the plaster, all wearing my mother's smile.",
  "start": 55.1,
  "end": 58.66,
  "startFrame": 1653,
  "endFrame": 1760,
  "words": [
   182,
   194
  ]
 },
 {
  "text": "I cut the ropes with a butter knife.",
  "start": 58.86,
  "end": 60.3,
  "startFrame": 1766,
  "endFrame": 1809,
  "words": [
   195,
   202
  ]
 },
 {
  "text": "We sprinted through hallways that breathed.",
  "start": 60.66,
  "end": 62.38,
  "startFrame": 1820,
  "endFrame": 1871,
  "words": [
   203,
   208
  ]
 },
 {
  "text": "The window turned gold.",
  "start": 62.72,
  "end": 63.82,
  "startFrame": 1882,
  "endFrame": 1915,
  "words": [
   209,
   212
  ]
 },
 {
  "text": "We dove through the closing door just as the sun rose.",
  "start": 64.16,
  "end": 66.68,
  "startFrame": 1925,
  "endFrame": 2000,
  "words": [
   213,
   223
  ]
 },
 {
  "text": "Dad was making pancakes.",
  "start": 67.0,
  "end": 67.96,
  "startFrame": 2010,
  "endFrame": 2039,
  "words": [
   224,
   227
  ]
 },
 {
  "text": "Mom squeezed my hand.",
  "start": 68.36,
  "end": 69.36,
  "startFrame": 2051,
  "endFrame": 2081,
  "words": [
   228,
   231
  ]
 },
 {
  "text": "\"Listen carefully,\" she whispered.",
  "start": 69.6,
  "end": 71.02,
  "startFrame": 2088,
  "endFrame": 2131,
  "words": [
   232,
   235
  ]
 },
 {
  "text": "\"Your father went through that door the night after me.",
  "start": 71.28,
  "end": 73.5,
  "startFrame": 2138,
  "endFrame": 2205,
  "words": [
   236,
   245
  ]
 },
 {
  "text": "He never came back.\"",
  "start": 73.7,
  "end": 74.64,
  "startFrame": 2211,
  "endFrame": 2239,
  "words": [
   246,
   249
  ]
 },
 {
  "text": "The man at the stove turned around.",
  "start": 74.92,
  "end": 76.32,
  "startFrame": 2248,
  "endFrame": 2290,
  "words": [
   250,
   256
  ]
 },
 {
  "text": "He smiled.",
  "start": 76.66,
  "end": 77.1,
  "startFrame": 2300,
  "endFrame": 2313,
  "words": [
   257,
   258
  ]
 },
 {
  "text": "\"Rock and roll,\" he said.",
  "start": 77.46,
  "end": 78.6,
  "startFrame": 2324,
  "endFrame": 2358,
  "words": [
   259,
   263
  ]
 },
 {
  "text": "\"Lose control.\"",
  "start": 78.94,
  "end": 79.48,
  "startFrame": 2368,
  "endFrame": 2384,
  "words": [
   264,
   265
  ]
 }
]