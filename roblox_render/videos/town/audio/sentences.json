[
 {
  "text": "In this town, laughing is illegal.",
  "start": 0.0,
  "end": 1.97,
  "startFrame": 0,
  "endFrame": 59,
  "words": [
   0,
   5
  ]
 },
 {
  "text": "Laugh once, and you pay a fine.",
  "start": 2.42,
  "end": 3.72,
  "startFrame": 73,
  "endFrame": 112,
  "words": [
   6,
   12
  ]
 },
 {
  "text": "Every street pole has a laugh detector camera.",
  "start": 4.06,
  "end": 6.04,
  "startFrame": 122,
  "endFrame": 181,
  "words": [
   13,
   20
  ]
 },
 {
  "text": "All the clowns are in jail, and comedies play with no sound.",
  "start": 6.32,
  "end": 9.08,
  "startFrame": 190,
  "endFrame": 272,
  "words": [
   21,
   32
  ]
 },
 {
  "text": "My dad giggled at work once, and he's still paying off the loan.",
  "start": 9.4,
  "end": 12.08,
  "startFrame": 282,
  "endFrame": 362,
  "words": [
   33,
   45
  ]
 },
 {
  "text": "Our teacher checks us for laughs by tickling us.",
  "start": 12.38,
  "end": 14.4,
  "startFrame": 371,
  "endFrame": 432,
  "words": [
   46,
   54
  ]
 },
 {
  "text": "Even babies cry on a strict schedule.",
  "start": 14.66,
  "end": 16.32,
  "startFrame": 440,
  "endFrame": 490,
  "words": [
   55,
   61
  ]
 },
 {
  "text": "My best friend Tootie is a smuggler.",
  "start": 16.64,
  "end": 18.12,
  "startFrame": 499,
  "endFrame": 544,
  "words": [
   62,
   68
  ]
 },
 {
  "text": "His great-grandpa was the town's last clown.",
  "start": 18.42,
  "end": 20.38,
  "startFrame": 553,
  "endFrame": 611,
  "words": [
   69,
   75
  ]
 },
 {
  "text": "Tootie carries jokes in his backpack, written on tiny notes.",
  "start": 20.8,
  "end": 23.34,
  "startFrame": 624,
  "endFrame": 700,
  "words": [
   76,
   85
  ]
 },
 {
  "text": "One note costs a dollar.",
  "start": 23.7,
  "end": 24.76,
  "startFrame": 711,
  "endFrame": 743,
  "words": [
   86,
   90
  ]
 },
 {
  "text": "A mother-in-law joke costs two.",
  "start": 24.98,
  "end": 26.58,
  "startFrame": 749,
  "endFrame": 797,
  "words": [
   91,
   95
  ]
 },
 {
  "text": "\"Rock and roll, we're losing control!\"",
  "start": 26.76,
  "end": 28.48,
  "startFrame": 803,
  "endFrame": 854,
  "words": [
   96,
   101
  ]
 },
 {
  "text": "He whispers, and I choke into my pillow.",
  "start": 28.86,
  "end": 30.72,
  "startFrame": 866,
  "endFrame": 922,
  "words": [
   102,
   109
  ]
 },
 {
  "text": "But something's weird.",
  "start": 31.12,
  "end": 31.96,
  "startFrame": 934,
  "endFrame": 959,
  "words": [
   110,
   112
  ]
 },
 {
  "text": "Every year, the town sinks a little deeper into the ground.",
  "start": 32.4,
  "end": 35.0,
  "startFrame": 972,
  "endFrame": 1050,
  "words": [
   113,
   123
  ]
 },
 {
  "text": "First the basements vanished, then the first floors.",
  "start": 35.32,
  "end": 37.46,
  "startFrame": 1060,
  "endFrame": 1124,
  "words": [
   124,
   131
  ]
 },
 {
  "text": "Mayor Pop says that's totally normal.",
  "start": 37.91,
  "end": 39.35,
  "startFrame": 1137,
  "endFrame": 1180,
  "words": [
   132,
   137
  ]
 },
 {
  "text": "One day, Tootie got caught.",
  "start": 39.69,
  "end": 40.93,
  "startFrame": 1191,
  "endFrame": 1228,
  "words": [
   138,
   142
  ]
 },
 {
  "text": "They put him in the middle of the square and burned all his notes.",
  "start": 41.13,
  "end": 43.71,
  "startFrame": 1234,
  "endFrame": 1311,
  "words": [
   143,
   156
  ]
 },
 {
  "text": "And right then, the whole town sank another three feet.",
  "start": 44.05,
  "end": 46.79,
  "startFrame": 1322,
  "endFrame": 1404,
  "words": [
   157,
   166
  ]
 },
 {
  "text": "Water poured through the windows.",
  "start": 47.15,
  "end": 48.33,
  "startFrame": 1414,
  "endFrame": 1450,
  "words": [
   167,
   171
  ]
 },
 {
  "text": "People screamed.",
  "start": 48.69,
  "end": 49.39,
  "startFrame": 1461,
  "endFrame": 1482,
  "words": [
   172,
   173
  ]
 },
 {
  "text": "I looked at Tootie, and he looked at me, and we got it.",
  "start": 49.77,
  "end": 52.13,
  "startFrame": 1493,
  "endFrame": 1564,
  "words": [
   174,
   186
  ]
 },
 {
  "text": "A hundred years ago, the town was built on a swamp, and only laughter kept it afloat.",
  "start": 52.41,
  "end": 56.15,
  "startFrame": 1572,
  "endFrame": 1684,
  "words": [
   187,
   203
  ]
 },
 {
  "text": "The water reached our knees.",
  "start": 56.34,
  "end": 57.61,
  "startFrame": 1690,
  "endFrame": 1728,
  "words": [
   204,
   208
  ]
 },
 {
  "text": "Tootie climbed onto a barrel and yelled, \"So Principal Fartan walks into an elevator...\"",
  "start": 58.01,
  "end": 61.37,
  "startFrame": 1740,
  "endFrame": 1841,
  "words": [
   209,
   222
  ]
 },
 {
  "text": "I couldn't hold it.",
  "start": 61.75,
  "end": 62.55,
  "startFrame": 1852,
  "endFrame": 1876,
  "words": [
   223,
   226
  ]
 },
 {
  "text": "I burst out laughing.",
  "start": 62.71,
  "end": 63.71,
  "startFrame": 1881,
  "endFrame": 1911,
  "words": [
   227,
   230
  ]
 },
 {
  "text": "The ground shook and rose a little.",
  "start": 64.01,
  "end": 65.53,
  "startFrame": 1920,
  "endFrame": 1966,
  "words": [
   231,
   237
  ]
 },
 {
  "text": "Then Mom laughed.",
  "start": 65.85,
  "end": 66.43,
  "startFrame": 1975,
  "endFrame": 1993,
  "words": [
   238,
   240
  ]
 },
 {
  "text": "Then Dad, then the police.",
  "start": 66.77,
  "end": 67.99,
  "startFrame": 2003,
  "endFrame": 2040,
  "words": [
   241,
   245
  ]
 },
 {
  "text": "The whole square laughed so hard the windows rattled.",
  "start": 68.37,
  "end": 70.95,
  "startFrame": 2051,
  "endFrame": 2128,
  "words": [
   246,
   254
  ]
 },
 {
  "text": "The town rose higher and higher.",
  "start": 71.23,
  "end": 72.87,
  "startFrame": 2137,
  "endFrame": 2186,
  "words": [
   255,
   260
  ]
 },
 {
  "text": "The fines were canceled.",
  "start": 73.32,
  "end": 74.22,
  "startFrame": 2200,
  "endFrame": 2227,
  "words": [
   261,
   264
  ]
 },
 {
  "text": "The clowns were set free.",
  "start": 74.5,
  "end": 75.6,
  "startFrame": 2235,
  "endFrame": 2268,
  "words": [
   265,
   269
  ]
 },
 {
  "text": "Now every pole has a sign: \"Laugh or drown.\"",
  "start": 75.94,
  "end": 78.42,
  "startFrame": 2278,
  "endFrame": 2353,
  "words": [
   270,
   278
  ]
 },
 {
  "text": "Only Mayor Pop never laughed.",
  "start": 78.76,
  "end": 79.98,
  "startFrame": 2363,
  "endFrame": 2399,
  "words": [
   279,
   283
  ]
 },
 {
  "text": "His house is the only one still underwater.",
  "start": 80.3,
  "end": 82.04,
  "startFrame": 2409,
  "endFrame": 2461,
  "words": [
   284,
   291
  ]
 },
 {
  "text": "And Tootie still hasn't told me how the elevator joke ends.",
  "start": 82.33,
  "end": 84.9,
  "startFrame": 2470,
  "endFrame": 2547,
  "words": [
   292,
   302
  ]
 }
]